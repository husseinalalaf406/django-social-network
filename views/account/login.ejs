<%- include('../layout/header', { title: 'Sign In | Social Network' }) %>

<div class="max-w-md mx-auto my-8 p-6 sm:p-8 bg-white rounded-2xl border border-gray-200/80 shadow-sm">
    <div class="mb-6 text-center">
        <h1 class="text-2xl font-bold text-gray-900">Sign In</h1>
        <p class="text-sm text-gray-500 mt-1">Welcome back! Enter your credentials to continue.</p>
    </div>

    <form method="POST" action="/accounts/login/" class="space-y-4">
        <div>
            <label for="username" class="block text-sm font-medium text-gray-700 mb-1">Username</label>
            <input type="text" id="username" name="username" required value="hussein" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
        </div>

        <div>
            <label for="password" class="block text-sm font-medium text-gray-700 mb-1">Password</label>
            <input type="password" id="password" name="password" required value="password123" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
        </div>

        <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-semibold py-2.5 px-4 rounded-lg shadow-sm transition duration-200 cursor-pointer">
            Sign In
        </button>
    </form>

    <div class="mt-6 pt-4 border-t border-gray-100 text-center text-sm text-gray-600">
        Don't have an account?
        <a href="/accounts/signup/" class="text-indigo-600 font-semibold hover:underline">Sign up</a>
    </div>

    <div class="mt-4 p-3 bg-gray-50 rounded-lg text-xs text-gray-500 text-center">
        Demo accounts: <span class="font-mono text-gray-700 font-semibold">hussein</span>, <span class="font-mono text-gray-700 font-semibold">sarah_dev</span>, <span class="font-mono text-gray-700 font-semibold">marcus_tech</span> (Password: <span class="font-mono">password123</span>)
    </div>
</div>

<%- include('../layout/footer') %>
