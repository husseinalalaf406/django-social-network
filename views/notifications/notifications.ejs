<%- include('../layout/header', { title: 'Notifications | Social Network' }) %>

<div class="max-w-2xl mx-auto px-4 py-6">
    <!-- Header -->
    <div class="flex items-center justify-between mb-5">
        <div>
            <h1 class="text-xl sm:text-2xl font-bold text-gray-900">Notifications</h1>
            <p class="text-xs sm:text-sm text-gray-500 mt-1">Stay updated with your activity.</p>
        </div>
    </div>

    <!-- Notifications List -->
    <% if (notifications && notifications.length > 0) { %>
        <div class="bg-white rounded-xl sm:rounded-2xl border border-gray-200/80 shadow-xs overflow-hidden">
            <% notifications.forEach(function(item) { %>
                <div class="flex items-center gap-3 sm:gap-4 px-4 sm:px-5 py-4 border-b border-gray-100 last:border-b-0 <%= !item.isRead ? 'bg-indigo-50/50' : 'bg-white' %> hover:bg-gray-50 transition">
                    <!-- Avatar -->
                    <a href="/profiles/<%= item.sender.username %>/" class="shrink-0">
                        <% if (item.sender.profile && item.sender.profile.avatar) { %>
                            <img src="<%= item.sender.profile.avatar %>" alt="<%= item.sender.username %>" class="w-10 h-10 sm:w-11 sm:h-11 rounded-full object-cover border border-gray-200" />
                        <% } else { %>
                            <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-gradient-to-tr from-indigo-500 to-violet-500 text-white font-bold flex items-center justify-center">
                                <%= item.sender.username.slice(0, 1).toUpperCase() %>
                            </div>
                        <% } %>
                    </a>

                    <!-- Notification Content -->
                    <div class="min-w-0 flex-1">
                        <p class="text-sm text-gray-800 leading-relaxed">
                            <a href="/profiles/<%= item.sender.username %>/" class="font-bold text-gray-900 hover:underline">
                                <%= item.sender.username %>
                            </a>
                            <% if (item.notificationType === 'like') { %>
                                liked your post ❤️
                            <% } else if (item.notificationType === 'comment') { %>
                                commented on your post 💬
                            <% } else if (item.notificationType === 'follow') { %>
                                started following you 👤
                            <% } %>
                        </p>
                        <p class="text-[11px] sm:text-xs text-gray-500 mt-1">
                            <%= new Date(item.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) %>
                        </p>
                    </div>

                    <!-- Unread Indicator -->
                    <% if (!item.isRead) { %>
                        <span class="w-2.5 h-2.5 shrink-0 rounded-full bg-indigo-600" title="Unread"></span>
                    <% } %>
                </div>
            <% }); %>
        </div>
    <% } else { %>
        <!-- Empty State -->
        <div class="bg-white rounded-xl sm:rounded-2xl border border-gray-200/80 shadow-xs p-8 sm:p-12 text-center">
            <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-indigo-50 text-indigo-600 flex items-center justify-center">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                </svg>
            </div>
            <h2 class="text-base sm:text-lg font-bold text-gray-900">No notifications yet</h2>
            <p class="text-xs sm:text-sm text-gray-500 mt-1">
                When someone likes, comments, or follows you, you'll see it here.
            </p>
        </div>
    <% } %>
</div>

<%- include('../layout/footer') %>
