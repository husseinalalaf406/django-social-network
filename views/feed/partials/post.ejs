<div class="space-y-5 sm:space-y-6">
    <!-- Section Header -->
    <div class="flex items-center justify-between gap-3">
        <h1 class="text-lg sm:text-xl font-bold text-gray-900 tracking-tight">
            <%= title || 'Recent Posts' %>
        </h1>

        <% if (posts && posts.length > 0) { %>
            <span class="shrink-0 text-[11px] sm:text-xs font-semibold text-gray-500 bg-gray-200/60 px-2.5 py-1 rounded-full">
                <%= posts.length %> <%= posts.length === 1 ? 'post' : 'posts' %>
            </span>
        <% } %>
    </div>

    <!-- Posts Loop -->
    <% if (posts && posts.length > 0) { %>
        <% posts.forEach(function(post) { %>
            <article class="bg-white rounded-xl sm:rounded-2xl border border-gray-200/80 shadow-xs overflow-hidden hover:shadow-md transition-shadow duration-200">
                <!-- Post Header -->
                <div class="flex items-center justify-between gap-3 px-4 sm:px-5 pt-4 sm:pt-5 pb-3">
                    <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
                        <!-- Avatar -->
                        <% if (post.author && post.author.profile && post.author.profile.avatar) { %>
                            <img src="<%= post.author.profile.avatar %>" alt="<%= post.author.username %>'s avatar" class="w-9 h-9 sm:w-10 sm:h-10 shrink-0 rounded-full object-cover border border-gray-200/80 shadow-xs" />
                        <% } else { %>
                            <div class="w-9 h-9 sm:w-10 sm:h-10 shrink-0 rounded-full bg-gradient-to-tr from-indigo-500 to-violet-500 text-white font-bold text-sm flex items-center justify-center shadow-xs">
                                <%= post.author ? post.author.username.slice(0, 1).toUpperCase() : 'U' %>
                            </div>
                        <% } %>

                        <!-- User Info -->
                        <div class="min-w-0">
                            <h3 class="truncate">
                                <a href="/profiles/<%= post.author ? post.author.username : '' %>/" class="font-bold text-gray-900 text-sm hover:text-indigo-600 transition-colors">
                                    <%= post.author ? (post.author.firstName + ' ' + post.author.lastName).trim() || post.author.username : 'Anonymous User' %>
                                </a>
                            </h3>
                            <p class="text-[11px] sm:text-xs text-gray-500 font-medium truncate">
                                <%= new Date(post.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }) %>
                            </p>
                        </div>
                    </div>

                    <!-- More Options / Profile Link -->
                    <a href="/profiles/<%= post.author ? post.author.username : '' %>/" class="shrink-0 text-gray-400 hover:text-gray-600 p-1.5 rounded-lg hover:bg-gray-100 transition cursor-pointer" aria-label="View author profile">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z" />
                        </svg>
                    </a>
                </div>

                <!-- Post Body -->
                <% if (post.text) { %>
                    <div class="px-4 sm:px-5 pb-4">
                        <p class="text-gray-800 text-sm leading-relaxed whitespace-pre-line break-words overflow-wrap-anywhere">
                            <%= post.text %>
                        </p>
                    </div>
                <% } %>

                <!-- Post Image -->
                <% if (post.image) { %>
                    <div class="px-4 sm:px-5 pb-4">
                        <img src="<%= post.image %>" alt="Post media" class="w-full max-h-[550px] object-cover rounded-xl border border-gray-200" />
                    </div>
                <% } %>

                <!-- Action Bar -->
                <div class="px-2 sm:px-5 py-2.5 sm:py-3 bg-gray-50/50 flex items-center justify-between gap-1 sm:gap-3 text-gray-600 text-xs font-semibold border-t border-gray-100">
                    <!-- Like Button -->
                    <button type="button" data-like-url="/post/<%= post.id %>/like/" class="like-button flex-1 sm:flex-none flex items-center justify-center gap-1 sm:gap-1.5 px-2 sm:px-3 py-2 rounded-lg transition cursor-pointer <%= post.isLiked ? 'text-rose-600 bg-rose-50' : 'text-gray-600 hover:bg-rose-50 hover:text-rose-600' %>">
                        <svg class="like-icon w-4 h-4 shrink-0" stroke="currentColor" fill="<%= post.isLiked ? 'currentColor' : 'none' %>" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                        </svg>
                        <span class="like-count"><%= post.likesCount %></span>
                        <span class="like-text"><%= post.isLiked ? 'Unlike' : 'Like' %></span>
                    </button>

                    <!-- Comment Button -->
                    <button type="button" class="js-comment-modal flex-1 sm:flex-none flex items-center justify-center gap-1 sm:gap-1.5 px-2 sm:px-3 py-2 rounded-lg hover:bg-indigo-50 hover:text-indigo-600 transition cursor-pointer" data-post-id="<%= post.id %>">
                        <svg class="w-4 h-4 shrink-0" stroke="currentColor" fill="none" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                        </svg>
                        <span>Comment</span>
                        <span id="comment-count-<%= post.id %>" class="comment-count"><%= post.commentsCount %></span>
                    </button>

                    <!-- Share Button -->
                    <button type="button" onclick="navigator.clipboard && navigator.clipboard.writeText(window.location.origin + '/#comments-modal-<%= post.id %>');" class="flex-1 sm:flex-none flex items-center justify-center gap-1 sm:gap-1.5 px-2 sm:px-3 py-2 rounded-lg hover:bg-gray-200/60 hover:text-gray-900 transition cursor-pointer">
                        <svg class="w-4 h-4 shrink-0" stroke="currentColor" fill="none" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
                        </svg>
                        <span>Share</span>
                    </button>
                </div>
            </article>

            <!-- Comments Modal for this Post -->
            <div id="comments-modal-<%= post.id %>" class="comments-modal hidden fixed inset-0 z-50 bg-black/50 backdrop-blur-sm px-4 flex items-start sm:items-center justify-center overflow-y-auto">
                <div class="bg-white w-full max-w-xl mx-auto my-4 sm:my-8 rounded-xl sm:rounded-2xl shadow-2xl overflow-hidden">
                    <!-- Header -->
                    <div class="flex items-center justify-between gap-4 px-4 sm:px-6 py-4 border-b border-gray-100">
                        <div>
                            <h2 class="text-lg sm:text-xl font-bold text-gray-900">Comments</h2>
                            <p class="text-xs text-gray-500 mt-0.5">
                                <span class="comment-modal-count"><%= post.commentsCount %></span> <%= post.commentsCount === 1 ? 'comment' : 'comments' %>
                            </p>
                        </div>
                        <button type="button" class="js-close-comment-modal text-gray-400 hover:text-gray-700 text-2xl leading-none cursor-pointer" aria-label="Close">&times;</button>
                    </div>

                    <!-- Comments List -->
                    <div class="comments-list px-4 sm:px-6 py-4 max-h-[60vh] overflow-y-auto">
                        <% if (post.comments && post.comments.length > 0) { %>
                            <div class="space-y-4">
                                <% post.comments.forEach(function(comment) { %>
                                    <div id="comment-<%= comment.id %>" class="comment-item flex items-start gap-2.5">
                                        <a href="/profiles/<%= comment.user.username %>/" class="relative shrink-0 block">
                                            <% if (comment.user.profile && comment.user.profile.avatar) { %>
                                                <img src="<%= comment.user.profile.avatar %>" alt="<%= comment.user.username %>" class="w-9 h-9 sm:w-10 sm:h-10 shrink-0 rounded-full object-cover border border-gray-200/80 shadow-xs" />
                                            <% } else { %>
                                                <div class="w-9 h-9 sm:w-10 sm:h-10 shrink-0 rounded-full bg-indigo-500 text-white font-bold text-sm flex items-center justify-center shadow-xs">
                                                    <%= comment.user.username.slice(0, 1).toUpperCase() %>
                                                </div>
                                            <% } %>
                                        </a>
                                        <div class="flex flex-col gap-1 flex-1">
                                            <div class="bg-gray-100 rounded-2xl px-4 py-2.5">
                                                <a href="/profiles/<%= comment.user.username %>/" class="text-sm font-semibold text-gray-900 hover:underline">
                                                    <%= comment.user.username %>
                                                </a>
                                                <p class="text-sm text-gray-800"><%= comment.text %></p>
                                            </div>
                                            <div class="flex items-center gap-3 pl-1 text-xs text-gray-500">
                                                <span><%= new Date(comment.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) %></span>
                                            </div>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>
                        <% } else { %>
                            <div class="py-10 text-center">
                                <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-indigo-50 text-indigo-600 flex items-center justify-center">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                                    </svg>
                                </div>
                                <h3 class="text-sm font-bold text-gray-900">No comments yet</h3>
                                <p class="text-xs text-gray-500 mt-1">Be the first to comment.</p>
                            </div>
                        <% } %>
                    </div>

                    <!-- Add Comment -->
                    <% if (user) { %>
                        <div class="border-t border-gray-100 p-4 sm:px-6">
                            <form method="POST" action="/post/<%= post.id %>/comment/" class="comment-form flex gap-2">
                                <input type="text" name="text" required placeholder="Write a comment..." class="flex-1 min-w-0 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
                                <button type="submit" class="bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-2 rounded-lg text-sm font-medium transition cursor-pointer">
                                    Post
                                </button>
                            </form>
                        </div>
                    <% } else { %>
                        <div class="border-t border-gray-100 p-4 text-center">
                            <a href="/accounts/login/" class="text-sm text-indigo-600 hover:underline font-medium">Log in to comment</a>
                        </div>
                    <% } %>
                </div>
            </div>
        <% }); %>
    <% } else { %>
        <!-- Empty State -->
        <div class="bg-white rounded-xl sm:rounded-2xl border border-gray-200/80 p-6 sm:p-8 text-center shadow-xs">
            <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-full flex items-center justify-center mx-auto mb-3">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                </svg>
            </div>
            <h3 class="text-base font-bold text-gray-900 mb-1">No posts found</h3>
            <p class="text-xs text-gray-500 max-w-sm mx-auto mb-5">
                Be the first person to share something with the community today!
            </p>

            <% if (user) { %>
                <button type="button" class="js-toggle-modal bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold px-4 py-2 rounded-xl shadow-xs transition cursor-pointer">
                    Create First Post
                </button>
            <% } else { %>
                <a href="/accounts/login/" class="inline-block bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold px-4 py-2 rounded-xl shadow-xs transition">
                    Log in to Post
                </a>
            <% } %>
        </div>
    <% } %>
</div>
