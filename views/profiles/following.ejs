<%- include('../layout/header', { title: 'Following - ' + profile_user.username + ' | Social Network' }) %>

<div class="max-w-2xl mx-auto">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-900">Following</h1>
        <p class="text-sm text-gray-500 mt-1">
            People @<%= profile_user.username %> follows
        </p>
    </div>

    <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-xs">
        <% if (following && following.length > 0) { %>
            <% following.forEach(function(followingUser) { %>
                <div class="flex items-center justify-between p-4 border-b border-gray-100 last:border-0 hover:bg-gray-50 transition">
                    <a href="/profiles/<%= followingUser.username %>/" class="flex items-center gap-3">
                        <% if (followingUser.profile && followingUser.profile.avatar) { %>
                            <img src="<%= followingUser.profile.avatar %>" class="w-12 h-12 rounded-full object-cover border border-gray-200 shadow-xs" alt="<%= followingUser.username %>">
                        <% } else { %>
                            <div class="w-12 h-12 rounded-full bg-indigo-500 text-white flex items-center justify-center font-bold shadow-xs">
                                <%= followingUser.username.slice(0, 1).toUpperCase() %>
                            </div>
                        <% } %>

                        <div>
                            <p class="font-semibold text-gray-900"><%= followingUser.username %></p>
                            <% if (followingUser.firstName || followingUser.lastName) { %>
                                <p class="text-sm text-gray-500"><%= (followingUser.firstName + ' ' + followingUser.lastName).trim() %></p>
                            <% } %>
                        </div>
                    </a>

                    <a href="/profiles/<%= followingUser.username %>/" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800 bg-indigo-50 px-3 py-1.5 rounded-lg transition">
                        View Profile
                    </a>
                </div>
            <% }); %>
        <% } else { %>
            <div class="p-8 text-center text-gray-500">
                Not following anyone yet.
            </div>
        <% } %>
    </div>
</div>

<%- include('../layout/footer') %>
