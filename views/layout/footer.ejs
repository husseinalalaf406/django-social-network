</main>

<!-- ================= NEW POST MODAL ================= -->
<div id="post-modal" class="hidden fixed inset-0 z-50 bg-black/50 backdrop-blur-sm px-4 flex items-start sm:items-center justify-center overflow-y-auto">
    <div class="bg-white w-full max-w-xl mx-auto my-4 sm:my-8 p-4 sm:p-6 rounded-xl sm:rounded-2xl shadow-2xl">
        <!-- Header -->
        <div class="flex items-center justify-between gap-4 mb-4">
            <h2 class="text-lg sm:text-xl font-bold text-gray-900">Create Post</h2>
            <button type="button" class="js-toggle-modal text-gray-400 hover:text-gray-700 text-2xl leading-none cursor-pointer" aria-label="Close">&times;</button>
        </div>

        <!-- Post Form -->
        <form method="POST" action="/new-posts/" enctype="multipart/form-data">
            <!-- Text -->
            <textarea name="text" rows="5" class="w-full border border-gray-300 rounded-lg p-3 text-sm sm:text-base resize-y focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" placeholder="What's on your mind?"></textarea>

            <!-- Image Upload or Image URL -->
            <div class="mt-4 space-y-2">
                <label for="post-image" class="block text-sm font-semibold text-gray-700">Add an image</label>
                <div class="flex flex-col gap-2">
                    <input id="post-image" type="file" name="image" accept="image/*" class="w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 cursor-pointer">
                    <input type="text" name="imageUrl" placeholder="Or paste an image URL (optional)" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                </div>
                <p class="text-xs text-gray-500">JPG, JPEG, PNG, WEBP or web image link</p>
            </div>

            <!-- Buttons -->
            <div class="mt-4 flex flex-col-reverse sm:flex-row sm:justify-end gap-2">
                <button type="button" class="js-toggle-modal w-full sm:w-auto px-4 py-2 rounded-lg text-gray-700 hover:bg-gray-100 transition-colors cursor-pointer">
                    Cancel
                </button>
                <button type="submit" class="w-full sm:w-auto bg-indigo-600 hover:bg-indigo-500 text-white px-5 py-2 rounded-lg font-medium transition-colors cursor-pointer">
                    Publish
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ================= SCRIPTS ================= -->
<script src="/static/feed/js/main.js"></script>
<script src="/static/profiles/js/main.js"></script>
</body>
</html>
